{
  "name": "yousang-engineering-notes",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "repository": "https://github.com/YouSangSon/yousangson.github.io",
  "scripts": {
    "dev": "pnpm prepare-posts && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "pnpm prepare-posts && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build --force && pnpm apply-lqip && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "apply-lqip": "tsx scripts/apply-lqip.ts",
    "prepare-posts": "tsx scripts/prepare-posts.ts",
    "verify": "tsx scripts/verify-site.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/sitemap": "^3.7.2",
    "@waline/client": "^3.13.0",
    "astro": "^6.1.5",
    "astro-compress": "^2.4.1",
    "feed": "^5.2.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.45",
    "lite-youtube-embed": "^0.3.4",
    "markdown-it": "^14.1.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.14.0",
    "node-html-parser": "^7.1.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.2",
    "sharp": "^0.34.5",
    "twikoo": "^1.7.7",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.1.1",
    "@astrojs/check": "^0.9.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/sanitize-html": "^2.16.1",
    "@unocss/astro": "66.6.8",
    "@unocss/eslint-plugin": "66.6.8",
    "@unocss/preset-attributify": "66.6.8",
    "@unocss/reset": "66.6.8",
    "astro-eslint-parser": "^1.4.0",
    "autocorrect-node": "^2.14.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.7.0",
    "fast-glob": "^3.3.3",
    "pagefind": "^1.4.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "unocss": "66.6.8",
    "unocss-preset-theme": "^0.14.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}

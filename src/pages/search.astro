---
import Layout from '@/layouts/Layout.astro'
---
<Layout postTitle="검색" postDescription="개발 기록에서 궁금한 내용을 찾아보세요.">
  <section aria-labelledby="search-heading">
    <h1 id="search-heading" class="mb-4 text-3xl font-bold">기록 검색</h1>
    <p class="mb-8">궁금한 기술이나 문제를 검색해 보세요.</p>
    <div id="search"></div>
    <noscript>검색하려면 JavaScript가 필요합니다. <a href="/archives/">전체 글 목록</a>에서도 글을 찾을 수 있습니다.</noscript>
  </section>
  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
function initSearch() {
  const container = document.getElementById('search')
  if (container && !container.children.length && window.PagefindUI) {
    void new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false, translations: { placeholder: '검색어를 입력하세요' } })
  }
}
initSearch()
document.addEventListener('astro:page-load', initSearch)
</script>
</Layout>
<style is:global>
  #search { --pagefind-ui-primary: oklch(var(--un-preset-theme-colors-primary)); --pagefind-ui-text: oklch(var(--un-preset-theme-colors-primary)); --pagefind-ui-background: oklch(var(--un-preset-theme-colors-background)); --pagefind-ui-border: #89867e; --pagefind-ui-border-radius: 6px; --pagefind-ui-font: inherit; }
  #search input:focus-visible, #search button:focus-visible, #search a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
